  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#aaaaaa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#febfca"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a9c9a0"
      }
    },
    {
      "name": "Regular expressions and escapes",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#9dcec7"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#febfca"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#e6cf98"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9fb5d8"
      }
    },
    {
      "name": "Types, classes and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.java",
        "storage.type.cs",
        "storage.type.rust",
        "storage.type.go"
      ],
      "settings": {
        "foreground": "#9dcec7"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f2f2f2"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#febfca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "entity.name.tag.toml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#9fb5d8"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#e6cf98"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#febfca"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e6cf98",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#e6cf98",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#e6cf98"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#febfca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9fb5d8"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#aaaaaa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#febfca"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#a9c9a0"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f58c9d"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e6cf98"
      }
    },
    {
      "name": "Diff ranges",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#9fb5d8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f58c9d"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f58c9d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#febfca",
    "function": "#9fb5d8",
    "method": "#9fb5d8",
    "function.defaultLibrary": "#9fb5d8",
    "type": "#9dcec7",
