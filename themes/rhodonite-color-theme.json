    "interface": "#9dcec7",
    "enum": "#9dcec7",
    "namespace": "#9dcec7",
    "typeParameter": "#9dcec7",
    "enumMember": "#e6cf98",
    "variable.readonly": "#f2f2f2",
    "variable.defaultLibrary": "#f2f2f2",
    "property.readonly": "#f2f2f2",
    "parameter": "#f2f2f2",
    "property": "#f2f2f2",
    "decorator": "#e6cf98",
    "macro": "#e6cf98",
    "selfKeyword": {
      "foreground": "#febfca",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
